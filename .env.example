# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Used by .mcp.json's github server (fine-grained PAT, read scope on target repos)
GITHUB_PAT=

# Used by .mcp.json's postgres server — point this at a READ-ONLY user
DATABASE_URL=postgresql://readonly:password@localhost:5432/mydb

# App
NODE_ENV=development
PORT=3000
